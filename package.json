{
  "name": "workverse",
  "version": "1.0.0",
  "description": "Server for workverse",
  "main": ".eslintrc.js",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "node server/lib/server/index.js",
    "build": "tsc --project server/tsconfig.server.json",
    "typecheck": "tsc --project server/tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{server,types}/**/*.ts\"",
    "format:check": "prettier --check \"{server,types}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mithran-MV/workverse.git"
  },
  "keywords": [],
  "author": "fabiomughilan",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Mithran-MV/workverse/issues"
  },
  "homepage": "https://github.com/Mithran-MV/workverse#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@colyseus/command": "^0.1.7",
    "@colyseus/monitor": "^0.14.0",
    "@colyseus/ws-transport": "^0.14.21",
    "@privy-io/react-auth": "^1.94.2",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@vitejs/plugin-react": "^4.3.3",
    "bcrypt": "^5.0.1",
    "colyseus": "^0.14.0",
    "colyseus.js": "^0.14.12",
    "cors": "^2.8.5",
    "express": "^4.16.4",
    "phaser": "^3.55.2",
    "regenerator-runtime": "^0.13.7",
    "typescript": "^4.8.2",
    "vite": "^5.4.11"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "engines": {
    "node": ">=20"
  }
}
