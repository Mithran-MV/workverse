# WebSocket URL of the Colyseus server. Required by a production build; in development
# the client falls back to port 2567 on whichever host serves the page.
VITE_SERVER_URL=wss://your-server.example.com

# URL of the Push Protocol chat app in client/Chat. The Connect button in the in-game
# chat window is hidden when this is not set.
VITE_CHAT_APP_URL=http://localhost:3000

# Privy application id. Only needed if you mount the provider in client/provider.
VITE_PRIVY_APP_ID=
