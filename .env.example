# Port the Colyseus server listens on.
PORT=2567

# Comma separated list of origins allowed to call the HTTP endpoints, e.g.
# https://workverse.example.com,http://localhost:5173
# Unset allows any origin, which is fine locally and wrong in production.
CORS_ORIGINS=

# Mount the Colyseus monitor at /colyseus. It exposes room contents and can disconnect
# clients, so leave it off unless you are debugging.
COLYSEUS_MONITOR=false

# Serve the built client from this process, for a single-container deploy.
SERVE_CLIENT=false
